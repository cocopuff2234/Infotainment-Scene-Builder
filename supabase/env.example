# Copy this file to .env.local in the project root, beside package.json.
# This is a Vite app: use VITE_, not NEXT_PUBLIC_.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# A legacy anon key can be used instead of the publishable key:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Only public browser keys belong here. Never use a service-role or sb_secret_ key.
# Restart npm run dev after changing .env.local.
